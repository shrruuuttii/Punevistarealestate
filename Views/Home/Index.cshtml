@{
    ViewData["Title"] = "Home - Find Your Dream Property";
}

<!-- Hero Section -->
<div class="hero-section mt-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4">Find Your Dream Property</h1>
        <p class="lead mb-4">Discover premium residential and commercial properties across Pune</p>
        
        <!-- Search Bar -->
        <div class="row justify-content-center mb-4">
            <div class="col-md-10">
                <form method="get" class="d-flex gap-2">
                    <input type="text" class="form-control search-bar" placeholder="Search location, property type..." />
                    <button type="submit" class="btn btn-secondary px-4">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </form>
            </div>
        </div>

        <!-- Quick Filters -->
        <div class="d-flex justify-content-center flex-wrap gap-2">
            <span class="filter-tag active">All Properties</span>
            <span class="filter-tag">Apartments</span>
            <span class="filter-tag">Villas</span>
            <span class="filter-tag">Commercial</span>
            <span class="filter-tag">Plots</span>
        </div>
    </div>
</div>

<!-- Featured Statistics -->
<section class="py-5">
    <div class="container">
        <div class="row" id="summary-cards">
            <div class="col-md-3 mb-4">
                <div class="summary-card">
                    <i class="fas fa-home summary-icon"></i>
                    <p class="summary-label">Total Properties</p>
                    <p class="summary-amount">500+</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="summary-card">
                    <i class="fas fa-handshake summary-icon"></i>
                    <p class="summary-label">Happy Customers</p>
                    <p class="summary-amount">2000+</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="summary-card">
                    <i class="fas fa-city summary-icon"></i>
                    <p class="summary-label">Locations Covered</p>
                    <p class="summary-amount">25+</p>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="summary-card">
                    <i class="fas fa-star summary-icon"></i>
                    <p class="summary-label">Average Rating</p>
                    <p class="summary-amount">4.8★</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Properties Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="display-5 fw-bold text-center mb-2">Featured Properties</h2>
                <p class="text-center text-muted">Handpicked premium properties for you</p>
            </div>
        </div>

        <div class="row">
            <!-- Property Card 1 -->
            <div class="col-md-4 mb-4">
                <div class="property-card">
                    <div class="property-image">
                        <img src="https://images.unsplash.com/photo-1570129477492-45c003fa2dba?w=400&h=300&fit=crop" alt="Modern Apartment">
                        <span class="property-badge">Featured</span>
                    </div>
                    <div class="property-body">
                        <h5 class="property-title">Luxury Apartment in Koregaon Park</h5>
                        <p class="property-location">
                            <i class="fas fa-map-marker-alt"></i>
                            Koregaon Park, Pune
                        </p>
                        <p class="property-price">₹ 1.50 Cr</p>
                        <div class="property-features">
                            <div class="property-feature">
                                <i class="fas fa-bed property-feature-icon"></i>
                                <small class="property-feature-text">3 BHK</small>
                            </div>
                            <div class="property-feature">
                                <i class="fas fa-bath property-feature-icon"></i>
                                <small class="property-feature-text">2 Bath</small>
                            </div>
                            <div class="property-feature">
                                <i class="fas fa-ruler property-feature-icon"></i>
                                <small class="property-feature-text">1800 sqft</small>
                            </div>
                        </div>
                        <button class="btn btn-primary w-100 mt-3">View Details</button>
                    </div>
                </div>
            </div>

            <!-- Property Card 2 -->
            <div class="col-md-4 mb-4">
                <div class="property-card">
                    <div class="property-image">
                        <img src="https://images.unsplash.com/photo-1512917774080-9b274b3057be?w=400&h=300&fit=crop" alt="Villa">
                        <span class="property-badge" style="background: #f39c12;">New</span>
                    </div>
                    <div class="property-body">
                        <h5 class="property-title">Spacious Villa in Aundh</h5>
                        <p class="property-location">
                            <i class="fas fa-map-marker-alt"></i>
                            Aundh, Pune
                        </p>
                        <p class="property-price">₹ 2.25 Cr</p>
                        <div class="property-features">
                            <div class="property-feature">
                                <i class="fas fa-bed property-feature-icon"></i>
                                <small class="property-feature-text">4 BHK</small>
                            </div>
                            <div class="property-feature">
                                <i class="fas fa-bath property-feature-icon"></i>
                                <small class="property-feature-text">3 Bath</small>
                            </div>
                            <div class="property-feature">
                                <i class="fas fa-ruler property-feature-icon"></i>
                                <small class="property-feature-text">2500 sqft</small>
                            </div>
                        </div>
                        <button class="btn btn-primary w-100 mt-3">View Details</button>
                    </div>
                </div>
            </div>

            <!-- Property Card 3 -->
            <div class="col-md-4 mb-4">
                <div class="property-card">
                    <div class="property-image">
                        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=400&h=300&fit=crop" alt="Modern Office">
                        <span class="property-badge" style="background: #e74c3c;">Urgent</span>
                    </div>
                    <div class="property-body">
                        <h5 class="property-title">Premium Office Space in Viman Nagar</h5>
                        <p class="property-location">
                            <i class="fas fa-map-marker-alt"></i>
                            Viman Nagar, Pune
                        </p>
                        <p class="property-price">₹ 80 L - 1.5 Cr</p>
                        <div class="property-features">
                            <div class="property-feature">
                                <i class="fas fa-building property-feature-icon"></i>
                                <small class="property-feature-text">Commercial</small>
                            </div>
                            <div class="property-feature">
                                <i class="fas fa-columns property-feature-icon"></i>
                                <small class="property-feature-text">Flexible</small>
                            </div>
                            <div class="property-feature">
                                <i class="fas fa-ruler property-feature-icon"></i>
                                <small class="property-feature-text">1000+ sqft</small>
                            </div>
                        </div>
                        <button class="btn btn-primary w-100 mt-3">View Details</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Transaction")" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-search me-2"></i>Explore All Properties
            </a>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="py-5">
    <div class="container">
        <h2 class="display-5 fw-bold text-center mb-5">Why Choose PuneVistaRealestate?</h2>
        
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <h5 class="card-title">Verified Properties</h5>
                        <p class="card-text">All properties are verified and authentically listed with complete documentation</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <i class="fas fa-headset fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">Expert Support</h5>
                        <p class="card-text">Dedicated team available 24/7 to assist you in finding the right property</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 text-center">
                    <div class="card-body">
                        <i class="fas fa-handshake fa-3x text-secondary mb-3"></i>
                        <h5 class="card-title">Best Deals</h5>
                        <p class="card-text">Access exclusive listings and negotiate the best prices with expert guidance</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="display-5 fw-bold text-center mb-5">What Our Customers Say</h2>
        
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="testimonial-card">
                    <div class="stars mb-2">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                    <p class="mb-3">"Excellent service! Found my dream home within 2 weeks. Highly recommended!"</p>
                    <strong>- Rajesh Kumar</strong>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="testimonial-card">
                    <div class="stars mb-2">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                    <p class="mb-3">"Very professional team. They guided me through the entire buying process smoothly."</p>
                    <strong>- Priya Singh</strong>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="testimonial-card">
                    <div class="stars mb-2">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                    <p class="mb-3">"Best real estate portal in Pune. Great collection of properties at competitive prices."</p>
                    <strong>- Amit Patel</strong>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5" style="background: linear-gradient(135deg, #2c5f9f 0%, #1e4573 100%);">
    <div class="container text-white text-center">
        <h2 class="display-5 fw-bold mb-4">Ready to Find Your Perfect Property?</h2>
        <p class="lead mb-4">Join thousands of satisfied customers who found their dream home with PuneVistaRealestate</p>
        @if (!User.Identity.IsAuthenticated)
        {
            <a href="@Url.Page("/Account/Register", new { area = "Identity" })" class="btn btn-secondary btn-lg px-5 me-3">
                <i class="fas fa-user-plus me-2"></i>Create Account
            </a>
            <a href="@Url.Page("/Account/Login", new { area = "Identity" })" class="btn btn-outline-light btn-lg px-5">
                <i class="fas fa-sign-in-alt me-2"></i>Login
            </a>
        }
        else
        {
            <a href="@Url.Action("Index", "Transaction")" class="btn btn-secondary btn-lg px-5 me-3">
                <i class="fas fa-search me-2"></i>Browse Properties
            </a>
            <a href="@Url.Action("Add", "Transaction")" class="btn btn-outline-light btn-lg px-5">
                <i class="fas fa-plus me-2"></i>List Your Property
            </a>
        }
    </div>
</section>
